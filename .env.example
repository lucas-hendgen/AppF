# CONFIGURAÇÕES DO BANCO DE DADOS MYSQL (XAMPP / Nuvem)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="farmacia_super_popular"

# MERCADO PAGO
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""

# AUTENTICAÇÃO E SEGURANÇA
JWT_SECRET="farmacia-super-popular-jwt-secret-key-2026"

# CREDENCIAIS DO ADMINISTRADOR (Configuração segura via ambiente - Zero exposição no código)
ADMIN_NAME="Farmacêutico Responsável"
ADMIN_EMAIL="admin@farmaciasuperpopular.com.br"
ADMIN_PASSWORD="admin123"
ADMIN_CPF="000.000.000-00"
ADMIN_PHONE="(47) 99999-8888"

# RATE LIMITING / PROTEÇÃO ANTI-BRUTE FORCE
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_LOGIN_IP_MAX="10"
RATE_LIMIT_LOGIN_IP_WINDOW_SEC="300"
RATE_LIMIT_LOGIN_ACCOUNT_MAX="5"
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SEC="600"
RATE_LIMIT_REGISTER_IP_MAX="5"
RATE_LIMIT_REGISTER_IP_WINDOW_SEC="600"
RATE_LIMIT_FORGOT_PASS_IP_MAX="5"
RATE_LIMIT_FORGOT_PASS_IP_WINDOW_SEC="600"
RATE_LIMIT_FORGOT_PASS_ACCOUNT_MAX="3"
RATE_LIMIT_FORGOT_PASS_ACCOUNT_WINDOW_SEC="600"
RATE_LIMIT_RESET_PASS_IP_MAX="8"
RATE_LIMIT_RESET_PASS_IP_WINDOW_SEC="600"
RATE_LIMIT_RESET_PASS_ACCOUNT_MAX="5"
RATE_LIMIT_RESET_PASS_ACCOUNT_WINDOW_SEC="600"

# URL DA APLICAÇÃO
APP_URL="http://localhost:3000"
